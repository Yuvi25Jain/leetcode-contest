🔹 Problem 1: Max Digit Range
✅ Final Optimized Code
cpp
int digitRange(int num) {
    int mx = 0, mn = 9;
    while (num > 0) {
        int d = num % 10;
        mx = max(mx, d);
        mn = min(mn, d);
        num /= 10;
    }
    return mx - mn;
}

int maxdigitrange(vector<int>& nums) {
    int maxRange = -1, ans = 0;
    for (int num : nums) {
        int r = digitRange(num);
        if (r > maxRange) {
            maxRange = r;
            ans = num;   // reset sum
        } else if (r == maxRange) {
            ans += num;
        }
    }
    return ans;
}
