brute force: Time Complexity: O(n²) , Space Complexity: O(n)

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        vector<int> ans;

        while (!nums.empty()) {
            set<int> distinct;

            // Find all distinct elements
            for (int x : nums) {
                distinct.insert(x);
            }

            // Append in ascending order
            for (int x : distinct) {
                ans.push_back(x);
            }

            // Remove one occurrence of each distinct element
            vector<int> next;
            unordered_set<int> removed;

            for (int x : nums) {
                if (removed.find(x) == removed.end()) {
                    removed.insert(x);   // remove first occurrence
                } else {
                    next.push_back(x);
                }
            }

            nums = next;
        }

        return ans;
    }
};

2️⃣ Better Approach (Frequency Map)

Key Observation: Don't physically delete elements. Just maintain frequencies.

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        map<int, int> freq;

        for (int x : nums) {
            freq[x]++;
        }

        vector<int> ans;

        while (true) {
            bool found = false;

            for (auto& [num, count] : freq) {
                if (count > 0) {
                    ans.push_back(num);
                    count--;
                    found = true;
                }
            }

            if (!found) break;
        }

        return ans;
    }
};

Time Complexity: O(k × maxFreq) (k = distinct values) ,Space Complexity: O(k)


3️⃣ Optimized Approach (Contest Solution)

Observation: Constraints say:

C++
1 <= nums[i] <= 100
Show more lines

Use a frequency array instead of a map.

C++
class Solution {
public:
vector<int> rearrangeArray(vector<int>& nums) {
vector<int> freq(101, 0);
 
for (int x : nums) {
freq[x]++;
}
 
vector<int> ans;
 
while (true) {
bool added = false;
 
for (int val = 1; val <= 100; val++) {
if (freq[val] > 0) {
ans.push_back(val);
freq[val]--;
added = true;
}
}
 
if (!added) break;
}
 
return ans;
}
};
