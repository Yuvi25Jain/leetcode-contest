q2. find all number disappeared in an array

class Solution {
public:
    vector<vector<int>> findDisappearedNumbers(vector<int>& nums, int lower, int upper) {

        vector<vector<int>>res;
        vector<int>a;
        nums.push_back(upper+1);
       
     

        for(int x : nums){
            if(x>= lower && x<=upper){
                a.push_back(x);
                
            }
        }
         sort(a.begin(), a.end());
         a.push_back(upper+1);
        int prev = lower-1;
        for(int x: a){
            if(x>prev+1){
                res.push_back({prev+1,x-1});
                
            }
            prev = x;
        }
        return res;
    }
};
