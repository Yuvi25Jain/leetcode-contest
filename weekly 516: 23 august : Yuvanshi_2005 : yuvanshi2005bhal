q1. check ASCII palindrome

given with string . (input) , output : true or false if palindrome

approach : convert character of that string into 8 bit binary representation. check that concatenates ascii string is palindrome or not ( 2 pointer , on reversal same then true else false if b[i] != b[j] return false then increment i and decrement j pointer)

//helper function : which convert letters into 8 bit binary represenation
    string toBin(char c){
        bitset<8>b((int)c);
        return b.to_string();
    }


    bool isPalindromic(string s) {
        string binStr = "";
        for(char ch :s){
            binStr += toBin(ch);
        }
        int i = 0 , j = binStr.size()-1;
        while(i<j){
            if(binStr[i] != binStr[j]) return false;
            i++;
            j--;
        }
        return true;
        
    }
