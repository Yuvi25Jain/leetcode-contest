Brute Force Approach
Generate each rotation explicitly.

For each rotation, count adjacent equal pairs with two pointers.

Compare with k.

#include <bits/stdc++.h>
using namespace std;

int countScore(const string &s) {
    int n = s.size();
    int score = 0;
    for (int i = 0; i < n - 1; i++) {
        if (s[i] == s[i + 1]) score++;
    }
    return score;
}

int bruteForce(string s, int k) {
    int n = s.size();
    int ans = 0;
    for (int rot = 0; rot < n; rot++) {
        // create rotation
        string rotated = s.substr(rot) + s.substr(0, rot);
        if (countScore(rotated) == k) ans++;
    }
    return ans;
}

int main() {
    string s = "aab";
    int k = 1;
    cout << bruteForce(s, k) << endl; // Output: 2
}

