Correct: cost uses 0‑based index.

Avoid off‑by‑one mistakes.

🟢 Brute Force Code
cpp
class Solution {
public:
    int countValidStrings(int n, int k) {
        int ans = 0;
        int total = 1 << n; // 2^n
        for (int mask = 0; mask < total; mask++) {
            int cost = 0;
            for (int i = 0; i < n; i++) {
                if (mask & (1 << i)) cost += i;
            }
            if (cost <= k) ans++;
        }
        return ans;
    }
};
🔵 Optimized DP Code
cpp
class Solution {
public:
    int countValidStrings(int n, int k) {
        vector<int> dp(k+1, 0);
        dp[0] = 1; // empty set

        for (int i = 0; i < n; i++) {
            for (int c = k; c >= i; c--) {
                dp[c] += dp[c - i];
            }
        }

        int ans = 0;
        for (int c = 0; c <= k; c++) ans += dp[c];
        return ans;
    }
};
🧠 Memory Hook
Brute force → try all masks.

Optimized DP → subset sum counting.

Trick: “at most k” → DP table.

If you see “valid binary strings with cost limit,” recall: subset sum of indices problem.

